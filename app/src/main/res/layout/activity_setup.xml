<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:importantForAccessibility="no"
            android:src="@mipmap/ic_launcher" />

        <TextView
            style="@style/Text.Title"
            android:layout_marginTop="12dp"
            android:text="@string/app_name" />

        <TextView
            style="@style/Text.Body"
            android:layout_marginTop="4dp"
            android:text="@string/tagline" />

        <TextView
            android:id="@+id/status"
            style="@style/Text.Body"
            android:layout_marginTop="20dp"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:textColor="@color/on_surface" />

        <Button
            android:id="@+id/install_instagram"
            style="@style/Action"
            android:text="@string/install_instagram" />

        <Button
            android:id="@+id/enable_guard"
            style="@style/Action"
            android:text="@string/enable_guard" />

        <TextView
            style="@style/Text.Small"
            android:layout_marginTop="8dp"
            android:text="@string/restricted_hint" />

        <Button
            android:id="@+id/app_info"
            style="@style/Action.Secondary"
            android:text="@string/app_info" />

        <Button
            android:id="@+id/open_messages"
            style="@style/Action"
            android:text="@string/open_messages" />

        <TextView
            style="@style/Text.Section"
            android:text="@string/section_block" />

        <Switch
            android:id="@+id/block_home"
            style="@style/Toggle"
            android:text="@string/block_home" />

        <Switch
            android:id="@+id/block_reels"
            style="@style/Toggle"
            android:text="@string/block_reels" />

        <Switch
            android:id="@+id/block_search"
            style="@style/Toggle"
            android:text="@string/block_search" />

        <Switch
            android:id="@+id/limit_shared_reels"
            style="@style/Toggle"
            android:text="@string/limit_shared_reels" />

        <Button
            android:id="@+id/pause"
            style="@style/Action.Secondary" />

        <TextView
            style="@style/Text.Section"
            android:text="@string/section_tips" />

        <TextView
            style="@style/Text.Small"
            android:text="@string/tips" />

        <TextView
            style="@style/Text.Section"
            android:text="@string/section_status" />

        <TextView
            android:id="@+id/diagnostics"
            style="@style/Text.Small"
            android:fontFamily="monospace"
            android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
