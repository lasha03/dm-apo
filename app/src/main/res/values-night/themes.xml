<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark parent => isLightTheme=false, so WebView's algorithmic darkening / prefers-color-scheme follow the system. -->
    <style name="Theme.DMs" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:colorBackground">@color/surface</item>
    </style>
</resources>
